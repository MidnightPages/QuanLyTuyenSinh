-- =====================================================================
-- HỆ THỐNG QUẢN LÝ TUYỂN SINH TRUNG TÂM - PostgreSQL
-- File 1/2: Tạo bảng, ràng buộc, chỉ mục
-- Chạy file này trước, sau đó chạy 02_du_lieu_mo_phong.sql
-- DROP TABLE IF EXISTS HoSoDangKy, PhanCongTuyenSinh,
--     DotKhoaHoc, KhoaHoc, DotTuyenSinh, NhanVien, TaiKhoan CASCADE;-- Ghi chú: tên bảng/cột không đặt trong dấu ngoặc kép nên PostgreSQL
-- tự chuyển thành chữ thường (TaiKhoan -> taikhoan).
-- =====================================================================
-- Drop database tuyensinh;
-- (Tùy chọn) Xóa bảng cũ để tạo lại từ đầu. CẨN THẬN: mất toàn bộ dữ liệu.

-- ---------------------------------------------------------------------
-- Bảng 1. TaiKhoan
-- ---------------------------------------------------------------------
CREATE TABLE TaiKhoan (
    MaTaiKhoan   INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    TenDangNhap  VARCHAR(50)  NOT NULL UNIQUE,
    MatKhauHash  VARCHAR(255) NOT NULL,
    VaiTro       VARCHAR(30)  NOT NULL,
    TrangThai    VARCHAR(30)  NOT NULL DEFAULT 'Hoạt động',
    CONSTRAINT ck_taikhoan_vaitro
        CHECK (VaiTro IN ('Quản trị viên', 'Nhân viên')),
    CONSTRAINT ck_taikhoan_trangthai
        CHECK (TrangThai IN ('Hoạt động', 'Đã khóa'))
);

-- ---------------------------------------------------------------------
-- Bảng 2. NhanVien (thông tin cá nhân của quản trị viên và nhân viên)
-- Xóa TaiKhoan chưa phát sinh dữ liệu thì xóa kèm NhanVien.
-- ---------------------------------------------------------------------
CREATE TABLE NhanVien (
    MaNhanVien   INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    MaTaiKhoan   INT NOT NULL UNIQUE
                 REFERENCES TaiKhoan (MaTaiKhoan) ON DELETE CASCADE,
    HoTen        VARCHAR(100) NOT NULL,
    NgaySinh     DATE,
    GioiTinh     VARCHAR(10),
    SoDienThoai  VARCHAR(15)
);

-- ---------------------------------------------------------------------
-- Bảng 3. DotTuyenSinh
-- ---------------------------------------------------------------------
CREATE TABLE DotTuyenSinh (
    MaDot        INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    TenDot       VARCHAR(150) NOT NULL,
    NgayBatDau   DATE NOT NULL,
    NgayKetThuc  DATE NOT NULL,
    TrangThai    VARCHAR(30)  NOT NULL DEFAULT 'Sắp diễn ra',
    MoTa         VARCHAR(500),
    CONSTRAINT ck_dot_ngay
        CHECK (NgayKetThuc >= NgayBatDau),
    CONSTRAINT ck_dot_trangthai
        CHECK (TrangThai IN ('Sắp diễn ra', 'Đang tuyển sinh', 'Đã kết thúc', 'Đã ngừng'))
);

-- ---------------------------------------------------------------------
-- Bảng 4. KhoaHoc
-- ---------------------------------------------------------------------
CREATE TABLE KhoaHoc (
    MaKhoaHoc    INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    TenKhoaHoc   VARCHAR(150) NOT NULL,
    HocPhi       NUMERIC(12,2) NOT NULL,
    ThoiLuong    VARCHAR(50),
    TrangThai    VARCHAR(30)  NOT NULL DEFAULT 'Đang mở',
    CONSTRAINT ck_khoahoc_hocphi
        CHECK (HocPhi >= 0),
    CONSTRAINT ck_khoahoc_trangthai
        CHECK (TrangThai IN ('Đang mở', 'Đã ngừng'))
);

-- ---------------------------------------------------------------------
-- Bảng 5. DotKhoaHoc (khóa học được mở trong từng đợt)
-- ---------------------------------------------------------------------
CREATE TABLE DotKhoaHoc (
    MaDotKhoaHoc INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    MaDot        INT NOT NULL REFERENCES DotTuyenSinh (MaDot) ON DELETE RESTRICT,
    MaKhoaHoc    INT NOT NULL REFERENCES KhoaHoc (MaKhoaHoc) ON DELETE RESTRICT,
    ChiTieu      INT NOT NULL DEFAULT 0 CHECK (ChiTieu >= 0),
    CONSTRAINT uq_dotkhoahoc UNIQUE (MaDot, MaKhoaHoc)
);

-- ---------------------------------------------------------------------
-- Bảng 6. PhanCongTuyenSinh
-- Một khóa học trong một đợt có thể có nhiều nhân viên phụ trách.
-- ---------------------------------------------------------------------
CREATE TABLE PhanCongTuyenSinh (
    MaPhanCong   INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    MaNhanVien   INT NOT NULL REFERENCES NhanVien (MaNhanVien) ON DELETE RESTRICT,
    MaDotKhoaHoc INT NOT NULL REFERENCES DotKhoaHoc (MaDotKhoaHoc) ON DELETE RESTRICT,
    CONSTRAINT uq_phancong UNIQUE (MaNhanVien, MaDotKhoaHoc)
);

-- ---------------------------------------------------------------------
-- Bảng 7. HoSoDangKy
-- ---------------------------------------------------------------------
CREATE TABLE HoSoDangKy (
    MaHoSo            INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    MaDotKhoaHoc      INT NOT NULL REFERENCES DotKhoaHoc (MaDotKhoaHoc) ON DELETE RESTRICT,
    HoTen             VARCHAR(100) NOT NULL,
    NgaySinh          DATE,
    SoDienThoai       VARCHAR(15)  NOT NULL,
    Email             VARCHAR(100) NOT NULL,
    DiaChi            VARCHAR(255),
    NgayDangKy        TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    TrangThaiHoSo     VARCHAR(30)  NOT NULL DEFAULT 'Chờ xử lý',
    MaNhanVienXacNhan INT REFERENCES NhanVien (MaNhanVien) ON DELETE RESTRICT,
    NgayXacNhan       TIMESTAMP,
    CONSTRAINT ck_hoso_trangthai
        CHECK (TrangThaiHoSo IN ('Chờ xử lý', 'Đã duyệt', 'Đã hủy')),
    CONSTRAINT ck_hoso_xacnhan
        CHECK ((MaNhanVienXacNhan IS NULL) = (NgayXacNhan IS NULL)),
    -- Chặn đăng ký trùng trong cùng một khóa học của cùng một đợt
    CONSTRAINT uq_hoso_sdt   UNIQUE (MaDotKhoaHoc, SoDienThoai),
    CONSTRAINT uq_hoso_email UNIQUE (MaDotKhoaHoc, Email)
);

-- ---------------------------------------------------------------------
-- Chỉ mục hỗ trợ tra cứu, lọc và thống kê
-- ---------------------------------------------------------------------
CREATE INDEX ix_hoso_dotkhoahoc ON HoSoDangKy (MaDotKhoaHoc);
CREATE INDEX ix_hoso_trangthai  ON HoSoDangKy (TrangThaiHoSo);
CREATE INDEX ix_hoso_nhanvien   ON HoSoDangKy (MaNhanVienXacNhan);
CREATE INDEX ix_phancong_dotkh  ON PhanCongTuyenSinh (MaDotKhoaHoc);
CREATE INDEX ix_dotkhoahoc_kh   ON DotKhoaHoc (MaKhoaHoc);

-- ---------------------------------------------------------------------
-- Trigger: chỉ nhân viên được phân công mới xác nhận được hồ sơ, và mỗi
-- hồ sơ chỉ do một nhân viên xác nhận (người xác nhận đầu tiên).
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION fn_hoso_kiem_tra_xac_nhan() RETURNS trigger AS $$
BEGIN
    IF NEW.MaNhanVienXacNhan IS NOT NULL THEN
        IF NOT EXISTS (
            SELECT 1 FROM PhanCongTuyenSinh pc
            WHERE pc.MaNhanVien = NEW.MaNhanVienXacNhan
              AND pc.MaDotKhoaHoc = NEW.MaDotKhoaHoc
        ) THEN
            RAISE EXCEPTION 'Nhân viên % không được phân công phụ trách khóa học này',
                NEW.MaNhanVienXacNhan;
        END IF;

        IF TG_OP = 'UPDATE'
           AND OLD.MaNhanVienXacNhan IS NOT NULL
           AND OLD.MaNhanVienXacNhan <> NEW.MaNhanVienXacNhan THEN
            RAISE EXCEPTION 'Hồ sơ % đã được nhân viên % xác nhận, nhân viên khác không được đổi',
                OLD.MaHoSo, OLD.MaNhanVienXacNhan;
        END IF;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_hoso_xac_nhan
    BEFORE INSERT OR UPDATE ON HoSoDangKy
    FOR EACH ROW EXECUTE FUNCTION fn_hoso_kiem_tra_xac_nhan();
